---
// Web3Forms access key configured via environment variable with production fallback
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || "86e757e5-5174-43cd-84ad-21d4f8794c89";
---

<div class="contact-grid">
  <!-- Left Column: Information & Direct Inquiries -->
  <div class="contact-info-col reveal-on-scroll">
    <span class="section-tag">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
      Get In Touch
    </span>
    <h1 class="contact-col-title">Start a technical conversation.</h1>
    <p class="contact-col-desc">
      Whether you are modernizing legacy spreadsheets, engineering unified data infrastructure, or deploying conversational AI, we provide direct engineering capability from day one.
    </p>

    <!-- Email Card with Click-to-copy -->
    <div class="contact-email-card">
      <div class="email-card-header">
        <span class="email-label">Direct Engineering Inquiries:</span>
      </div>
      <div class="email-interactive-row">
        <a href="mailto:info@bluedune.tech" class="email-address-text" id="contact-email-val">
          info@bluedune.tech
        </a>
        <button
          type="button"
          id="copy-email-btn"
          class="copy-btn"
          aria-label="Copy email address to clipboard"
        >
          <svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <span class="copy-text">Copy</span>
        </button>
      </div>
      <span id="copy-feedback" class="copy-feedback" aria-live="polite"></span>
    </div>

    <div class="contact-meta-card">
      <div class="meta-item">
        <svg class="meta-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <div class="meta-text">
          <strong>Response time:</strong> We reply within one business day.<br />
          Working week: Sunday to Thursday, Gulf Standard Time (GST).
        </div>
      </div>

      <div class="meta-item">
        <svg class="meta-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <div class="meta-text">
          <strong>Agencies &amp; Consultancies:</strong> We regularly act as the specialized data and software engineering execution partner for consulting firms and digital agencies under NDA.
        </div>
      </div>
    </div>
  </div>

  <!-- Right Column: Brief Submission Form -->
  <div class="contact-form-col reveal-on-scroll">
    <div class="form-card">
      <h3 class="form-card-title">Send us a project brief</h3>
      <p class="form-card-sub">Tell us about what you want to fix or build.</p>

      <form id="project-brief-form" novalidate data-access-key={web3FormsKey}>
        <!-- Honeypot anti-spam field -->
        <input type="checkbox" name="botcheck" class="honeypot-field" style="display: none;" tabindex="-1" autocomplete="off" />
        
        <!-- Web3Forms Config -->
        <input type="hidden" name="access_key" value={web3FormsKey} />
        <input type="hidden" name="from_name" value="BlueDuneSolution Website" />
        <input type="hidden" name="subject" value="New Project Brief Submission from bluedune.tech" />

        <div class="form-row">
          <div class="form-group">
            <label for="contact-name">Your Name <span class="req">*</span></label>
            <input
              type="text"
              id="contact-name"
              name="name"
              class="form-input"
              placeholder="Full name"
              required
            />
            <span class="field-error" id="name-error"></span>
          </div>

          <div class="form-group">
            <label for="contact-email">Work Email <span class="req">*</span></label>
            <input
              type="email"
              id="contact-email"
              name="email"
              class="form-input"
              placeholder="name@company.com"
              required
            />
            <span class="field-error" id="email-error"></span>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="contact-company">Company / Organization <span class="req">*</span></label>
            <input
              type="text"
              id="contact-company"
              name="company"
              class="form-input"
              placeholder="Company name"
              required
            />
            <span class="field-error" id="company-error"></span>
          </div>

          <div class="form-group">
            <label for="contact-category">What you need <span class="req">*</span></label>
            <select id="contact-category" name="service_category" class="form-select" required>
              <option value="" disabled selected>Select an area...</option>
              <option value="Data platform or pipelines">Data platform or pipelines</option>
              <option value="AI or RAG system">AI or RAG system</option>
              <option value="Automation or agents">Automation or agents</option>
              <option value="Analytics or forecasting">Analytics or forecasting</option>
              <option value="Web or API product">Web or API product</option>
              <option value="Mobile or computer vision">Mobile or computer vision</option>
              <option value="Not sure yet">Not sure yet</option>
            </select>
            <span class="field-error" id="category-error"></span>
          </div>
        </div>

        <div class="form-group">
          <label for="contact-timeline">Rough timeline <span class="req">*</span></label>
          <select id="contact-timeline" name="timeline" class="form-select" required>
            <option value="" disabled selected>Select rough timeline...</option>
            <option value="Immediate / within 1 month">Immediate / within 1 month</option>
            <option value="1 to 3 months">1 to 3 months</option>
            <option value="3 to 6 months">3 to 6 months</option>
            <option value="Exploring / planning stage">Exploring / planning stage</option>
          </select>
          <span class="field-error" id="timeline-error"></span>
        </div>

        <div class="form-group">
          <label for="contact-message">Project Brief &amp; Context <span class="req">*</span></label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            class="form-textarea"
            placeholder="Describe the current problem, data sources, goals, or operational requirements..."
            required
          ></textarea>
          <span class="field-error" id="message-error"></span>
        </div>

        <div class="form-group consent-group">
          <label class="checkbox-container">
            <input type="checkbox" id="contact-consent" name="consent" required />
            <span class="checkbox-mark"></span>
            <span class="consent-label">
              I agree that this information will be used to respond to my project inquiry, in accordance with the <a href="/privacy" target="_blank" rel="noopener">Privacy Notice</a>. <span class="req">*</span>
            </span>
          </label>
          <span class="field-error" id="consent-error"></span>
        </div>

        <!-- Submission Status Banner -->
        <div id="form-status-banner" class="status-banner" role="alert" style="display: none;"></div>

        <button type="submit" id="form-submit-btn" class="btn btn-primary btn-submit">
          <span class="btn-text">Send project brief</span>
          <svg class="spinner-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display: none;">
            <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
            <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path>
          </svg>
          <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>
    </div>
  </div>
</div>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 1.1fr 1.3fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .contact-col-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    margin-block-end: 1rem;
    color: #FFFFFF;
  }

  .contact-col-desc {
    font-size: 1.1rem;
    color: #B4C6E7;
    line-height: 1.6;
    margin-block-end: 2rem;
  }

  .contact-email-card {
    background: rgba(23, 32, 49, 0.8);
    border: 1px solid rgba(41, 182, 212, 0.25);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin-block-end: 2rem;
    position: relative;
  }

  .email-card-header {
    margin-block-end: 0.5rem;
  }

  .email-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-cyan);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .email-interactive-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .email-address-text {
    font-family: var(--font-heading);
    font-size: clamp(1.05rem, 3.8vw, 1.35rem);
    font-weight: 700;
    color: #FFFFFF;
    text-decoration: none;
    letter-spacing: 0.01em;
    word-break: break-all;
  }

  .email-address-text:hover {
    color: var(--color-cyan);
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(41, 182, 212, 0.12);
    border: 1px solid rgba(41, 182, 212, 0.3);
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .copy-btn:hover {
    background: rgba(41, 182, 212, 0.22);
    color: #FFFFFF;
  }

  .copy-feedback {
    display: block;
    font-size: 0.8rem;
    color: var(--color-cyan);
    margin-top: 0.4rem;
    min-height: 1.2rem;
    font-family: var(--font-mono);
  }

  .contact-meta-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: rgba(18, 26, 40, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .meta-icon {
    color: var(--color-cyan);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .meta-text {
    font-size: 0.9rem;
    color: #94A3B8;
    line-height: 1.55;
  }

  .meta-text strong {
    color: #FFFFFF;
  }

  /* Form Styling */
  .form-card {
    background: #121A28;
    border: 1px solid rgba(41, 182, 212, 0.2);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    box-shadow: var(--shadow-lg);
  }

  .form-card-title {
    font-size: 1.65rem;
    color: #FFFFFF;
    margin-block-end: 0.4rem;
  }

  .form-card-sub {
    font-size: 0.95rem;
    color: #94A3B8;
    margin-block-end: 2rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 600px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-block-end: 1.25rem;
  }

  .form-group label {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 500;
    color: #CBD5E1;
  }

  .req {
    color: var(--color-cyan);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    background: rgba(23, 32, 49, 0.7);
    border: 1px solid rgba(41, 182, 212, 0.2);
    border-radius: var(--radius-sm);
    color: #FFFFFF;
    font-family: var(--font-body);
    font-size: 0.95rem;
    padding: 0.8rem 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-cyan);
    background: rgba(23, 32, 49, 0.95);
    box-shadow: 0 0 14px rgba(41, 182, 212, 0.25);
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: #64748B;
  }

  .form-select option {
    background: #172031;
    color: #FFFFFF;
  }

  .field-error {
    font-size: 0.8rem;
    color: #F87171;
    min-height: 1rem;
    font-family: var(--font-mono);
  }

  /* Consent checkbox */
  .consent-group {
    margin-block-end: 1.5rem;
  }

  .checkbox-container {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 0.85rem;
    color: #94A3B8;
    line-height: 1.5;
  }

  .checkbox-container input {
    margin-top: 3px;
    accent-color: var(--color-cyan);
    width: 17px;
    height: 17px;
    cursor: pointer;
  }

  .consent-label a {
    color: var(--color-cyan);
    text-decoration: underline;
  }

  /* Status Banner */
  .status-banner {
    padding: 1rem 1.25rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-block-end: 1.5rem;
  }

  .status-banner.success {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #A7F3D0;
  }

  .status-banner.error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #FECACA;
  }

  .btn-submit {
    width: 100%;
    padding-block: 1rem;
    font-size: 1.05rem;
  }

  .spinner-icon {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (max-width: 640px) {
    .form-input,
    .form-select,
    .form-textarea {
      font-size: 16px;
    }

    .form-card {
      padding: 1.5rem 1.15rem;
    }
  }
</style>

<script>
  function initContactForm() {
    // 1. Click to copy email
    const copyBtn = document.getElementById('copy-email-btn');
    const feedback = document.getElementById('copy-feedback');
    const emailVal = 'info@bluedune.tech';

    if (copyBtn && feedback) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(emailVal);
          feedback.textContent = '✓ Copied to clipboard!';
          setTimeout(() => {
            feedback.textContent = '';
          }, 3500);
        } catch (err) {
          feedback.textContent = 'Please email us directly at ' + emailVal;
        }
      });
    }

    // 2. Form submission via Web3Forms
    const form = document.getElementById('project-brief-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement | null;
    const banner = document.getElementById('form-status-banner');

    if (!form || !submitBtn || !banner) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Reset errors
      document.querySelectorAll('.field-error').forEach((el) => {
        el.textContent = '';
      });
      banner.style.display = 'none';
      banner.className = 'status-banner';
      banner.innerHTML = '';

      let hasError = false;

      // Validate Name
      const nameInput = form.elements.namedItem('name') as HTMLInputElement;
      if (!nameInput.value.trim()) {
        const err = document.getElementById('name-error');
        if (err) err.textContent = 'Please enter your name.';
        hasError = true;
      }

      // Validate Email
      const emailInput = form.elements.namedItem('email') as HTMLInputElement;
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailInput.value.trim() || !emailRegex.test(emailInput.value.trim())) {
        const err = document.getElementById('email-error');
        if (err) err.textContent = 'Please provide a valid work email address.';
        hasError = true;
      }

      // Validate Company
      const companyInput = form.elements.namedItem('company') as HTMLInputElement;
      if (!companyInput.value.trim()) {
        const err = document.getElementById('company-error');
        if (err) err.textContent = 'Please specify your company or organization.';
        hasError = true;
      }

      // Validate Service Category
      const catInput = form.elements.namedItem('service_category') as HTMLSelectElement;
      if (!catInput.value) {
        const err = document.getElementById('category-error');
        if (err) err.textContent = 'Please select a capability area.';
        hasError = true;
      }

      // Validate Timeline
      const timeInput = form.elements.namedItem('timeline') as HTMLSelectElement;
      if (!timeInput.value) {
        const err = document.getElementById('timeline-error');
        if (err) err.textContent = 'Please select an estimated timeline.';
        hasError = true;
      }

      // Validate Message
      const msgInput = form.elements.namedItem('message') as HTMLTextAreaElement;
      if (!msgInput.value.trim() || msgInput.value.trim().length < 10) {
        const err = document.getElementById('message-error');
        if (err) err.textContent = 'Please enter at least 10 characters describing your inquiry.';
        hasError = true;
      }

      // Validate Consent
      const consentInput = form.elements.namedItem('consent') as HTMLInputElement;
      if (!consentInput.checked) {
        const err = document.getElementById('consent-error');
        if (err) err.textContent = 'Please confirm consent before submitting.';
        hasError = true;
      }

      if (hasError) return;

      // Check Honeypot
      const botCheck = form.elements.namedItem('botcheck') as HTMLInputElement;
      if (botCheck && botCheck.checked) {
        return; // Bot detected, silent reject
      }

      // Loading state
      submitBtn.disabled = true;
      const btnText = submitBtn.querySelector('.btn-text');
      const spinner = submitBtn.querySelector('.spinner-icon') as HTMLElement | null;
      const arrow = submitBtn.querySelector('.arrow-icon') as HTMLElement | null;
      if (btnText) btnText.textContent = 'Submitting project brief...';
      if (spinner) spinner.style.display = 'inline-block';
      if (arrow) arrow.style.display = 'none';

      const accessKey = form.dataset.accessKey || '';
      const formData = new FormData(form);
      const payload: Record<string, any> = {
        access_key: accessKey
      };
      formData.forEach((val, key) => {
        if (key !== 'botcheck' && key !== 'consent') {
          payload[key] = val;
        }
      });

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (response.ok && result.success) {
          banner.className = 'status-banner success';
          banner.innerHTML = `<strong>Thank you!</strong> Your project brief has been received. We will review your requirements and respond within one business day.`;
          banner.style.display = 'block';
          form.reset();
        } else {
          throw new Error(result.message || 'Submission failed');
        }
      } catch (error) {
        banner.className = 'status-banner error';
        banner.innerHTML = `<strong>Submission issue:</strong> We could not deliver your form at this moment. Please email your brief directly to our engineering desk at <a href="mailto:info@bluedune.tech" style="color: #FFFFFF; text-decoration: underline;">info@bluedune.tech</a> and we will reply promptly.`;
        banner.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Send project brief';
        if (spinner) spinner.style.display = 'none';
        if (arrow) arrow.style.display = 'inline-block';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm);
  } else {
    initContactForm();
  }
</script>
