---
// HeroCanvas: Interactive canvas combining flowing dune waves, circuit traces, and reactive data nodes
---

<div class="hero-canvas-wrapper" aria-hidden="true">
  <canvas id="hero-canvas" class="hero-canvas"></canvas>
  <div class="canvas-radial-overlay"></div>
</div>

<style>
  .hero-canvas-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .hero-canvas {
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: auto;
  }

  .canvas-radial-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 30%, transparent 20%, rgba(23, 32, 49, 0.7) 70%, #172031 100%);
    pointer-events: none;
  }
</style>

<script>
  function initHeroCanvas() {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let animationFrameId: number | null = null;
    let isVisible = true;

    // Mouse coordinates relative to canvas
    let mouse = { x: -1000, y: -1000, targetX: -1000, targetY: -1000 };

    interface Node {
      x: number;
      y: number;
      baseX: number;
      baseY: number;
      radius: number;
      pulse: number;
      pulseSpeed: number;
      connections: number[];
    }

    let nodes: Node[] = [];
    const NODE_COUNT = 36;
    let time = 0;

    function resize() {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      if (ctx) {
        ctx.scale(dpr, dpr);
      }
      initNodes();
      if (prefersReducedMotion) {
        drawStatic();
      }
    }

    function initNodes() {
      nodes = [];
      const cols = 6;
      const rows = 6;
      const colStep = width / (cols + 1);
      const rowStep = height / (rows + 1);

      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          const jitterX = (Math.random() - 0.5) * colStep * 0.7;
          const jitterY = (Math.random() - 0.5) * rowStep * 0.7;
          const x = (i + 1) * colStep + jitterX;
          const y = (j + 1) * rowStep + jitterY;

          nodes.push({
            x,
            y,
            baseX: x,
            baseY: y,
            radius: Math.random() * 2 + 2,
            pulse: Math.random() * Math.PI * 2,
            pulseSpeed: 0.02 + Math.random() * 0.02,
            connections: []
          });
        }
      }

      // Connect nearest neighbors with circuit-style Manhattan or direct links
      for (let i = 0; i < nodes.length; i++) {
        const dists: { index: number; dist: number }[] = [];
        for (let j = 0; j < nodes.length; j++) {
          if (i === j) continue;
          const dx = nodes[i].baseX - nodes[j].baseX;
          const dy = nodes[i].baseY - nodes[j].baseY;
          const dist = Math.hypot(dx, dy);
          if (dist < colStep * 1.8) {
            dists.push({ index: j, dist });
          }
        }
        dists.sort((a, b) => a.dist - b.dist);
        nodes[i].connections = dists.slice(0, 2).map((d) => d.index);
      }
    }

    // Interactive mouse parallax & glow
    window.addEventListener('mousemove', (e) => {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      mouse.targetX = e.clientX - rect.left;
      mouse.targetY = e.clientY - rect.top;
    }, { passive: true });

    // Dune / Wave lines drawer
    function drawDuneWaves(t: number) {
      if (!ctx) return;

      const waveConfigs = [
        { yBase: height * 0.68, amp: 45, freq: 0.0018, speed: 0.0008, color: 'rgba(27, 63, 125, 0.45)', strokeWidth: 2 },
        { yBase: height * 0.78, amp: 35, freq: 0.0025, speed: -0.0012, color: 'rgba(41, 182, 212, 0.25)', strokeWidth: 1.5 },
        { yBase: height * 0.88, amp: 25, freq: 0.0032, speed: 0.0015, color: 'rgba(23, 99, 161, 0.35)', strokeWidth: 1.8 }
      ];

      waveConfigs.forEach((cfg) => {
        ctx.beginPath();
        ctx.strokeStyle = cfg.color;
        ctx.lineWidth = cfg.strokeWidth;

        for (let x = 0; x <= width; x += 15) {
          const mouseDistX = Math.abs(x - mouse.x);
          const mouseEffect = Math.max(0, 1 - mouseDistX / 300) * 15;
          const y = cfg.yBase +
            Math.sin(x * cfg.freq + t * cfg.speed) * cfg.amp +
            Math.cos(x * cfg.freq * 0.5 + t * cfg.speed * 0.7) * (cfg.amp * 0.4) -
            mouseEffect;

          if (x === 0) {
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
        }
        ctx.stroke();
      });
    }

    // Circuit trace & data nodes drawer
    function drawCircuitNodes(t: number) {
      if (!ctx) return;

      // Draw connections
      nodes.forEach((node, i) => {
        node.connections.forEach((targetIndex) => {
          if (targetIndex > i) {
            const target = nodes[targetIndex];
            const dx = target.x - node.x;
            const dy = target.y - node.y;

            // Proximity to mouse enhances line brightness
            const midX = (node.x + target.x) / 2;
            const midY = (node.y + target.y) / 2;
            const distToMouse = Math.hypot(midX - mouse.x, midY - mouse.y);
            const isNearMouse = distToMouse < 180;
            const alpha = isNearMouse ? 0.45 : 0.12;

            ctx.beginPath();
            ctx.strokeStyle = isNearMouse ? `rgba(41, 182, 212, ${alpha})` : `rgba(27, 63, 125, ${alpha})`;
            ctx.lineWidth = isNearMouse ? 1.5 : 1;

            // 90-degree circuit traces (orthogonal routing)
            ctx.moveTo(node.x, node.y);
            ctx.lineTo(node.x + dx * 0.6, node.y);
            ctx.lineTo(target.x, target.y);
            ctx.stroke();
          }
        });
      });

      // Draw nodes
      nodes.forEach((node) => {
        node.pulse += node.pulseSpeed;
        const currentRadius = node.radius + Math.sin(node.pulse) * 0.8;

        const distToMouse = Math.hypot(node.x - mouse.x, node.y - mouse.y);
        const isNearMouse = distToMouse < 160;

        // Base glowing circle
        ctx.beginPath();
        ctx.arc(node.x, node.y, currentRadius, 0, Math.PI * 2);
        ctx.fillStyle = isNearMouse ? '#29B6D4' : '#1763A1';
        ctx.shadowColor = '#29B6D4';
        ctx.shadowBlur = isNearMouse ? 12 : 5;
        ctx.fill();

        // Outer halo when near mouse
        if (isNearMouse) {
          ctx.beginPath();
          ctx.arc(node.x, node.y, currentRadius + 6, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(41, 182, 212, 0.35)';
          ctx.lineWidth = 1;
          ctx.stroke();
        }

        ctx.shadowBlur = 0; // reset
      });
    }

    function animate(timestamp: number) {
      if (!isVisible || prefersReducedMotion) return;

      time += 1;
      mouse.x += (mouse.targetX - mouse.x) * 0.08;
      mouse.y += (mouse.targetY - mouse.y) * 0.08;

      // Update node positions subtly based on mouse
      nodes.forEach((node) => {
        const dx = mouse.x - node.baseX;
        const dy = mouse.y - node.baseY;
        const dist = Math.hypot(dx, dy);
        if (dist < 200) {
          const force = (1 - dist / 200) * 12;
          node.x = node.baseX + (dx / dist) * force;
          node.y = node.baseY + (dy / dist) * force;
        } else {
          node.x += (node.baseX - node.x) * 0.05;
          node.y += (node.baseY - node.y) * 0.05;
        }
      });

      if (ctx) {
        ctx.clearRect(0, 0, width, height);
        drawDuneWaves(time);
        drawCircuitNodes(time);
      }

      animationFrameId = requestAnimationFrame(animate);
    }

    function drawStatic() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      drawDuneWaves(100);
      drawCircuitNodes(100);
    }

    // Pause when off-screen to preserve battery & GPU
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        const entry = entries[0];
        isVisible = entry.isIntersecting;
        if (isVisible && !prefersReducedMotion && !animationFrameId) {
          animationFrameId = requestAnimationFrame(animate);
        } else if (!isVisible && animationFrameId) {
          cancelAnimationFrame(animationFrameId);
          animationFrameId = null;
        }
      }, { threshold: 0.05 });

      observer.observe(canvas);
    }

    window.addEventListener('resize', resize, { passive: true });
    resize();

    if (!prefersReducedMotion) {
      animationFrameId = requestAnimationFrame(animate);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroCanvas);
  } else {
    initHeroCanvas();
  }
</script>
