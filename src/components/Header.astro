---
export interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/work", label: "Work" },
  { href: "/process", label: "Process" },
  { href: "/contact", label: "Contact" }
];

const cleanPath = currentPath.replace(/\/$/, "") || "/";
---

<header id="site-header" class="site-header" role="banner">
  <div class="header-inner container">
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label="BlueDuneSolution Home">
      <picture>
        <source srcset="/brand/logo-horizontal-on-dark.webp" type="image/webp" />
        <img
          src="/brand/logo-horizontal-on-dark.png"
          alt="BlueDuneSolution logo"
          width="180"
          height="53"
          class="header-logo"
          loading="eager"
          decoding="async"
        />
      </picture>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list" role="list">
        {navLinks.map((link) => {
          const isActive = cleanPath === link.href || (link.href !== "/" && cleanPath.startsWith(link.href));
          return (
            <li class="nav-item">
              <a
                href={link.href}
                class={`nav-link ${isActive ? "active" : ""}`}
                aria-current={isActive ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="/contact" class="btn btn-primary header-cta">
        <span>Send project brief</span>
        <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        class="mobile-menu-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav-drawer" class="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-nav-content container">
      <nav aria-label="Mobile Navigation">
        <ul class="mobile-nav-list" role="list">
          {navLinks.map((link) => {
            const isActive = cleanPath === link.href || (link.href !== "/" && cleanPath.startsWith(link.href));
            return (
              <li class="mobile-nav-item">
                <a
                  href={link.href}
                  class={`mobile-nav-link ${isActive ? "active" : ""}`}
                  aria-current={isActive ? "page" : undefined}
                >
                  <span class="link-label">{link.label}</span>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="mobile-nav-cta">
        <a href="/contact" class="btn btn-primary btn-full-width">
          <span>Send us a project brief</span>
          <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <p class="mobile-contact-line">Direct inquiries: <a href="mailto:info@bluedune.tech">info@bluedune.tech</a></p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: rgba(23, 32, 49, 0.88);
    transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, backdrop-filter 0.3s ease;
    border-block-end: 1px solid rgba(41, 182, 212, 0.08);
  }

  .site-header.is-scrolled {
    background-color: rgba(18, 25, 38, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block-end: 1px solid rgba(41, 182, 212, 0.18);
    box-shadow: 0 4px 24px rgba(10, 15, 23, 0.35);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: 1.5rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    outline-offset: 4px;
    z-index: 102;
  }

  .header-logo {
    display: block;
    height: 42px;
    width: auto;
    object-fit: contain;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 860px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }

  .nav-link {
    position: relative;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 500;
    color: #B4C6E7;
    text-decoration: none;
    padding-block: 0.5rem;
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    inset-inline-start: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-cyan) 0%, var(--color-brand-blue) 100%);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover {
    color: #FFFFFF;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link.active {
    color: #FFFFFF;
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    z-index: 102;
  }

  .header-cta {
    display: none;
    padding-inline: 1.25rem;
    padding-block: 0.65rem;
    font-size: 0.875rem;
  }

  @media (min-width: 640px) {
    .header-cta {
      display: inline-flex;
    }
  }

  /* Mobile hamburger button */
  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 8px;
    background: rgba(27, 63, 125, 0.25);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-sm);
    cursor: pointer;
    z-index: 102;
    transition: background-color 0.2s ease;
  }

  .mobile-menu-toggle:hover {
    background: rgba(41, 182, 212, 0.2);
  }

  .hamburger-bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: #FFFFFF;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .mobile-menu-toggle[aria-expanded="true"] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu-toggle[aria-expanded="true"] .hamburger-bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle[aria-expanded="true"] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (min-width: 860px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  /* Mobile Drawer */
  .mobile-nav-drawer {
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(18, 25, 38, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 101;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-10px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    overflow-y: auto;
  }

  .mobile-nav-drawer.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mobile-nav-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: 2rem 3rem;
    height: 100%;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
    padding-inline: 1rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 500;
    color: #B4C6E7;
    text-decoration: none;
    border-bottom: 1px solid rgba(41, 182, 212, 0.1);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: #FFFFFF;
    background-color: rgba(41, 182, 212, 0.08);
  }

  .mobile-nav-link.active {
    color: var(--color-cyan);
    font-weight: 600;
  }

  .mobile-nav-cta {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .btn-full-width {
    width: 100%;
    padding-block: 1rem;
    font-size: 1.05rem;
  }

  .mobile-contact-line {
    font-size: 0.875rem;
    color: var(--text-muted-light);
    text-align: center;
  }
</style>

<script>
  // Sticky header scroll behavior and mobile menu handling
  function initHeader() {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');

    if (header) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
          header.classList.add('is-scrolled');
        } else {
          header.classList.remove('is-scrolled');
        }
      }, { passive: true });
    }

    if (toggle && drawer) {
      function setMenuState(open: boolean) {
        toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
        drawer?.setAttribute('aria-hidden', open ? 'false' : 'true');
        if (open) {
          drawer?.classList.add('is-open');
          document.body.style.overflow = 'hidden';
        } else {
          drawer?.classList.remove('is-open');
          document.body.style.overflow = '';
        }
      }

      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        setMenuState(!isOpen);
      });

      // Close on escape key
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          setMenuState(false);
          toggle.focus();
        }
      });

      // Close when clicking mobile link
      const mobileLinks = drawer.querySelectorAll('.mobile-nav-link');
      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => {
          setMenuState(false);
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
</script>
