---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import TechMarquee from '../components/TechMarquee.astro';
import BentoCapabilities from '../components/BentoCapabilities.astro';
import DataFlowDiagram from '../components/DataFlowDiagram.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import SchematicSvg from '../components/SchematicSvg.astro';

const selectedProjects = [
  {
    id: "transport-management",
    title: "Transport Management System",
    client: "Mohamed Waseem Investment SPC",
    clientNote: "Named with permission",
    tag: "Named client",
    summary: "Full-stack system to manage trips and their financial data with role-based operational access.",
    stack: ["React", "FastAPI", "PostgreSQL", "REST APIs"],
    type: "transport" as const
  },
  {
    id: "arabic-legal-search",
    title: "Arabic Legal Document Search",
    client: "Law firm, Oman",
    clientNote: "Name withheld under confidentiality",
    tag: "Delivered via partner",
    summary: "Production Arabic-language RAG system with hybrid semantic and keyword retrieval across legislation and judicial rulings.",
    stack: ["LangChain", "Hybrid retrieval", "FastAPI", "MongoDB", "Docker"],
    type: "arabic-legal" as const
  },
  {
    id: "uk-construction-assistant",
    title: "AI Assistant for UK Construction Teams",
    client: "Construction project teams, UK",
    clientNote: "Name withheld under confidentiality",
    tag: "Delivered via partner",
    summary: "Real-time conversational assistant delivering low-latency specification and operational context for active site teams.",
    stack: ["LangChain / LangGraph", "FastAPI", "WebSockets"],
    type: "uk-construction" as const
  }
];
---

<BaseLayout
  title="BlueDuneSolution | Data, AI and Software for Oman's Growing Businesses"
  description="We turn scattered data and manual processes into reliable data platforms, automation and software your team can trust. Data engineering at the core."
>
  <!-- 1. Hero Section -->
  <section class="hero-section" aria-label="Introduction">
    <HeroCanvas />

    <div class="container hero-container">
      <div class="hero-content reveal-on-scroll">
        <div class="hero-badge">
          <span class="badge-node" aria-hidden="true"></span>
          <span>Data-engineering-led software house</span>
        </div>

        <h1 class="hero-headline">
          Data, AI and software for Oman's growing businesses.
        </h1>

        <p class="hero-subheadline">
          We turn scattered data and manual processes into reliable data platforms, automation and software your team can trust.
        </p>

        <div class="hero-cta-group">
          <a href="/contact" class="btn btn-primary btn-hero">
            <span>Send us a project brief</span>
            <svg class="arrow-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a href="/work" class="btn btn-secondary btn-hero">
            <span>See our work</span>
          </a>
        </div>

        <div class="hero-supporting-line">
          <span class="supporting-icon" aria-hidden="true">&bull;</span>
          <span>Data engineering at the core. Complete digital products around it.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Technology Marquee -->
  <TechMarquee />

  <!-- Story / Positioning Section (Oman technology adoption) -->
  <section class="section section-dark story-section" aria-label="Why BlueDune">
    <div class="container container-narrow">
      <div class="story-card reveal-on-scroll">
        <span class="section-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
            <path d="M2 12h20"></path>
          </svg>
          Regional Perspective
        </span>
        <h2 class="story-title">
          Getting the data right before adding AI.
        </h2>
        <p class="story-body">
          Oman is adopting new technology quickly, and businesses need a partner who gets the data right before adding AI. Without dependable pipelines, validated schemas, and clean ingestion, AI systems fail or deliver misleading answers.
        </p>
        <p class="story-body">
          We build the underlying data foundation first—connecting operational systems, structuring data stores, and establishing reliable pipelines—then build automation, intelligent agents, and custom software on top.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. What We Do: Bento Capabilities -->
  <BentoCapabilities />

  <!-- 4. Interactive Data Flow Diagram -->
  <DataFlowDiagram />

  <!-- 5. Selected Work Preview -->
  <section class="section section-dark selected-work-section" aria-labelledby="work-preview-title">
    <div class="container">
      <div class="section-header reveal-on-scroll">
        <span class="section-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="14" x="2" y="5" rx="2"></rect>
            <line x1="2" y1="10" x2="22" y2="10"></line>
          </svg>
          Case Studies
        </span>
        <h2 id="work-preview-title" class="section-title">Selected work</h2>
        <p class="section-subtitle">
          Engineered systems delivered for enterprise operations, partner integrations, and specialized industry requirements.
        </p>
      </div>

      <div class="work-cards-grid">
        {selectedProjects.map((proj, idx) => (
          <article class="work-card reveal-on-scroll" style={`transition-delay: ${idx * 90}ms;`}>
            <div class="card-schematic">
              <SchematicSvg projectType={proj.type} />
            </div>

            <div class="card-details">
              <div class="card-meta">
                <span class={`badge-tag ${proj.tag === 'Named client' ? 'badge-tag-named' : 'badge-tag-partner'}`}>
                  {proj.tag}
                </span>
                <span class="client-name">{proj.client}</span>
              </div>

              <h3 class="card-heading">{proj.title}</h3>
              <p class="card-summary">{proj.summary}</p>

              <div class="card-stack-row">
                {proj.stack.map((tech) => (
                  <span class="stack-chip">{tech}</span>
                ))}
              </div>

              <div class="card-action">
                <a href="/work" class="view-project-link">
                  <span>View project details</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="work-view-all reveal-on-scroll">
        <a href="/work" class="btn btn-secondary">
          <span>Explore all projects &amp; architecture</span>
          <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. How We Work (Timeline) -->
  <section class="section section-dark-alt how-we-work-section" aria-labelledby="timeline-heading">
    <div class="container">
      <div class="section-header reveal-on-scroll">
        <span class="section-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 14 14"></polyline>
          </svg>
          Delivery Methodology
        </span>
        <h2 id="timeline-heading" class="section-title">How we work</h2>
        <p class="section-subtitle">
          A disciplined six-stage engineering process from initial audit to production handover and ongoing support.
        </p>
      </div>

      <ProcessTimeline variant="home-horizontal" />
    </div>
  </section>

  <!-- 7. Closing Call-To-Action Band on Navy -->
  <section class="section section-dark cta-closing-section" aria-labelledby="closing-cta-heading">
    <div class="container">
      <div class="cta-banner reveal-on-scroll">
        <div class="cta-glow-bg" aria-hidden="true"></div>
        <div class="cta-content">
          <span class="section-tag">Start An Inquiry</span>
          <h2 id="closing-cta-heading" class="cta-headline">
            Tell us what you are trying to fix.
          </h2>
          <p class="cta-sub">
            Send us a project brief or reach out directly to discuss data infrastructure, automation workflows, or software development.
          </p>
          <div class="cta-actions">
            <a href="/contact" class="btn btn-primary btn-cta-large">
              <span>Send us a project brief</span>
              <svg class="arrow-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="mailto:info@bluedune.tech" class="btn btn-secondary btn-cta-email">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>info@bluedune.tech</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Styles */
  .hero-section {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    background-color: var(--color-navy);
    overflow: hidden;
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-cyan);
    background: rgba(41, 182, 212, 0.1);
    border: 1px solid rgba(41, 182, 212, 0.25);
    padding-inline: 0.95rem;
    padding-block: 0.4rem;
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .badge-node {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 10px var(--color-cyan);
  }

  .hero-headline {
    font-size: clamp(2.4rem, 5.2vw, 4.1rem);
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.14;
    letter-spacing: -0.025em;
  }

  .hero-subheadline {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: #CBD5E1;
    line-height: 1.6;
    max-width: 720px;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-block-start: 0.5rem;
  }

  .btn-hero {
    padding-inline: 2rem;
    padding-block: 1rem;
    font-size: 1.05rem;
  }

  .hero-supporting-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.925rem;
    color: #94A3B8;
    margin-block-start: 0.5rem;
  }

  .supporting-icon {
    color: var(--color-cyan);
    font-size: 1.25rem;
  }

  /* Story section */
  .story-section {
    background: linear-gradient(180deg, var(--color-navy) 0%, #121a28 100%);
    padding-block: 4rem;
  }

  .story-card {
    background: rgba(27, 63, 125, 0.15);
    border: 1px solid rgba(41, 182, 212, 0.18);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 5vw, 3rem);
    text-align: center;
  }

  .story-title {
    font-size: clamp(1.75rem, 3.2vw, 2.35rem);
    color: #FFFFFF;
    margin-block-end: 1.25rem;
  }

  .story-body {
    font-size: 1.05rem;
    color: #CBD5E1;
    line-height: 1.7;
    margin-block-end: 1rem;
  }

  /* Selected Work */
  .section-header {
    text-align: center;
    max-width: 680px;
    margin-inline: auto;
    margin-block-end: clamp(2.5rem, 5vw, 3.5rem);
  }

  .work-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-block-end: 3rem;
  }

  @media (min-width: 900px) {
    .work-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .work-card {
    background: rgba(23, 32, 49, 0.75);
    border: 1px solid rgba(41, 182, 212, 0.16);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .work-card:hover {
    transform: translateY(-5px);
    border-color: rgba(41, 182, 212, 0.5);
    box-shadow: 0 16px 36px rgba(10, 16, 26, 0.45);
  }

  .card-schematic {
    padding: 1rem;
    background: #0d1420;
    border-bottom: 1px solid rgba(41, 182, 212, 0.12);
  }

  .card-details {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.85rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .client-name {
    font-size: 0.8rem;
    color: var(--text-muted-light);
  }

  .card-heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: #FFFFFF;
  }

  .card-summary {
    font-size: 0.9rem;
    color: #94A3B8;
    line-height: 1.55;
    flex: 1;
    margin: 0;
  }

  .card-stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block: 0.5rem;
  }

  .card-action {
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .view-project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-cyan);
    transition: gap 0.2s ease;
  }

  .view-project-link:hover {
    gap: 0.75rem;
    color: #FFFFFF;
  }

  .work-view-all {
    display: flex;
    justify-content: center;
  }

  /* Closing CTA Band */
  .cta-closing-section {
    padding-block: clamp(4rem, 7vw, 6.5rem);
    background-color: #0f1622;
  }

  .cta-banner {
    position: relative;
    background: linear-gradient(135deg, rgba(27, 63, 125, 0.35) 0%, rgba(23, 32, 49, 0.85) 100%);
    border: 1px solid rgba(41, 182, 212, 0.28);
    border-radius: var(--radius-xl);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 5vw, 3.5rem);
    text-align: center;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }

  .cta-glow-bg {
    position: absolute;
    top: -50%;
    left: 20%;
    width: 60%;
    height: 200%;
    background: radial-gradient(circle, rgba(41, 182, 212, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-headline {
    font-size: clamp(2.1rem, 4.2vw, 3.25rem);
    color: #FFFFFF;
    font-weight: 700;
    line-height: 1.15;
  }

  .cta-sub {
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    color: #CBD5E1;
    line-height: 1.6;
    margin-block-end: 0.5rem;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .btn-cta-large {
    padding-inline: 2rem;
    padding-block: 1rem;
    font-size: 1.05rem;
  }

  .btn-cta-email {
    padding-inline: 1.5rem;
    padding-block: 1rem;
    font-family: var(--font-mono);
  }
</style>
